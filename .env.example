# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Supabase modern API keys:
# - Legacy JWT-based API keys ("anon" & "service_role") are phased out by 2027.
# - New projects use "Publishable key" (client-safe) and "Secret key" (backend-only).
#
# 1. Project Reference:
#    Find your Project ID under: Project Settings > General -> Reference ID (Project ID)
#    Or use the full Project URL (https://<project-id>.supabase.co)
VITE_SUPABASE_PROJECT_ID=your-project-id
# VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Modern Publishable Key:
#    Find under: Project Settings > API Keys -> Publishable key (starts with sb_publishable_)
#    This key is safe for client-side applications and respects Row Level Security (RLS).
#
#    ⚠️ CAUTION: NEVER put your "Secret key" (sb_secret_...) here!
#    Secret keys bypass Row Level Security and must only be used in secure backend environments.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# ------------------------------------------------------------------------------
# Backward Compatibility Fallbacks (Legacy):
# ------------------------------------------------------------------------------
# If you are still using legacy keys, these will continue to work until deprecated:
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key
